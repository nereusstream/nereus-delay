docker compose -f e2e/docker-compose.oxia.yml -p "$project" build oxia
docker compose -f e2e/docker-compose.oxia.yml -p "$project" up -d oxia
healthy=0
for attempt in {1..60}; do
  if docker compose -f e2e/docker-compose.oxia.yml -p "$project" exec -T oxia oxia health --host 127.0.0.1 --port 6648 --timeout 2s; then healthy=1; break; fi
  sleep 0.5
done
[[ "$healthy" == 1 ]]
NEREUS_DELAY_OXIA_ENDPOINT="localhost:$NEREUS_DELAY_OXIA_E2E_PORT" NEREUS_DELAY_OXIA_NAMESPACE=default \
