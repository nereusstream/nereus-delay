#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C LANG=C
cd /Users/liusinan/apps/ideaproject/nereusstream/nereus-delay
export NEREUS_DELAY_OXIA_CHECKOUT=/Users/liusinan/apps/ideaproject/nereusstream/oxia
export NEREUS_DELAY_OXIA_E2E_PORT=31642
project="ndip3-oxia-intent-provider-$(date +%s)-$$"
compose() { docker compose --project-name "$project" --file e2e/docker-compose.oxia.yml "$@"; }
cleanup() { local status=$?; compose down --volumes --rmi local >/dev/null 2>&1 || true; exit "$status"; }
trap cleanup EXIT INT TERM
[[ -z "$(git -C "$NEREUS_DELAY_OXIA_CHECKOUT" status --porcelain)" ]]
if lsof -nP -iTCP:31642 -sTCP:LISTEN >/dev/null 2>&1; then exit 2; fi
printf 'Oxia source: '; git -C "$NEREUS_DELAY_OXIA_CHECKOUT" rev-parse HEAD
printf 'Oxia Dockerfile SHA256: '; shasum -a 256 "$NEREUS_DELAY_OXIA_CHECKOUT/Dockerfile"
printf 'Compose project: %s\n' "$project"
compose up --build --detach
container="$(compose ps -q oxia)"
docker inspect --format 'Container image ID: {{.Image}}' "$container"
ready=false
for attempt in $(seq 1 60); do
 if compose exec --no-TTY oxia oxia health --host 127.0.0.1 --port 6648 --timeout 2s >/dev/null 2>&1; then ready=true; break; fi
 sleep 1
done
if [[ "$ready" != true ]]; then compose logs oxia; exit 3; fi
NEREUS_DELAY_OXIA_ENDPOINT=127.0.0.1:31642 NEREUS_DELAY_OXIA_NAMESPACE=default GRADLE_USER_HOME=/private/tmp/nereus-delay-gradle ./gradlew test --rerun --tests com.nereusstream.delay.store.OxiaRealCheckpointPublicationSmokeTest.asynchronousIntentRegistrationPersistsUnderCurrentOwnerAndIndependentSession --no-daemon --console=plain

