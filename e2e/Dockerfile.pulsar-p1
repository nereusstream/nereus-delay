FROM eclipse-temurin:21-jre

WORKDIR /opt/pulsar

ARG PULSAR_TARBALL=apache-pulsar-5.0.0-M1-bin.tar.gz
COPY ${PULSAR_TARBALL} /tmp/pulsar.tar.gz
COPY pulsar-p1-entrypoint.sh /opt/pulsar/pulsar-p1-entrypoint.sh

RUN tar -xzf /tmp/pulsar.tar.gz --strip-components=1 \
    && rm /tmp/pulsar.tar.gz \
    && chmod +x /opt/pulsar/bin/*.sh /opt/pulsar/pulsar-p1-entrypoint.sh \
    && mkdir -p /pulsar/data /pulsar/logs

ENV PULSAR_MEM="-Xms256m -Xmx512m -XX:MaxDirectMemorySize=512m"
ENTRYPOINT ["/opt/pulsar/pulsar-p1-entrypoint.sh"]
